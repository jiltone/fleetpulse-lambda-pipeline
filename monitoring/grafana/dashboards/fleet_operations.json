  "panels": [
    {
      "id": 2,
      "type": "stat",
      "title": "Active vehicles",
      "description": "Distinct vehicles seen in the latest 1-minute window of each zone",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fleet-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fleet-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT SUM(active_vehicles) FROM (SELECT DISTINCT ON (zone) * FROM rt_zone_metrics ORDER BY zone, window_start DESC) z",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "text"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Fleet idle ratio",
      "description": "Share of pings that were idle (weighted by zone activity)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fleet-postgres"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fleet-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT SUM(idle_ratio * event_count) / NULLIF(SUM(event_count), 0) FROM (SELECT DISTINCT ON (zone) * FROM rt_zone_metrics ORDER BY zone, window_start DESC) z",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "text"
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
