    {
      "id": 12,
      "type": "table",
      "title": "Open idle alerts",
      "description": "Business alert from the speed layer; resolves automatically when the vehicle moves",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fleet-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fleet-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT vehicle_id, driver_id, zone, ROUND(idle_sim_minutes) AS idle_sim_minutes, idle_since, detected_at FROM idle_alerts WHERE status = 'open' ORDER BY idle_sim_minutes DESC",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 13,
      "type": "table",
      "title": "Latest profitability (batch layer)",
      "description": "Recomputed from the raw Parquet lake. Profit text: red = loss, blue = profit; status column states it in words too.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fleet-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fleet-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT vehicle_id, trips_completed AS trips, earnings, total_cost, profit, ROUND(profit_margin * 100, 1) AS margin_pct, CASE WHEN is_unprofitable THEN 'Unprofitable' ELSE 'OK' END AS status, CASE WHEN trending_unprofitable THEN 'Falling ' || consecutive_profit_drops || ' days' ELSE '' END AS trend FROM daily_vehicle_profitability WHERE sim_date = (SELECT MAX(sim_date) FROM daily_vehicle_profitability) ORDER BY is_unprofitable DESC, profit",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
