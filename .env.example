# =====================================================================
# FleetPulse Lambda Pipeline - configuration
# Copy this file to `.env` and change the passwords before running:
#     cp .env.example .env
# Every service reads its settings from here (no hard-coded hosts/passwords).
# =====================================================================

# ---------- Simulated clock ----------
# 1 simulated day = SIM_DAY_SECONDS real seconds (600 = 10 real minutes).
SIM_DAY_SECONDS=600
# The simulated calendar date that "day 0" of the simulation maps to.
SIM_START_DATE=2025-01-01
# File holding the real Unix time at which the simulation started.
# The first component to start creates it; everyone else reads it,
# so all containers agree on the current simulated day.
SIM_ANCHOR_FILE=data/sim_anchor.txt

# ---------- Kafka (KRaft, single broker) ----------
# Address used by containers inside the Docker network.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# Port published on your laptop (localhost:29092) for debugging tools.
KAFKA_EXTERNAL_PORT=29092
# Any 22-character base64 UUID; identifies the KRaft cluster.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_TELEMETRY_TOPIC=fleet.telemetry
KAFKA_TELEMETRY_PARTITIONS=3
KAFKA_DLQ_TOPIC=fleet.telemetry.dlq
KAFKA_UI_PORT=8085

# ---------- PostgreSQL ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Port published on your laptop (5433 avoids clashing with a local Postgres).
POSTGRES_HOST_PORT=5433
# Business database `fleet` (owned by this user).
POSTGRES_USER=fleet
POSTGRES_PASSWORD=change_me_fleet
POSTGRES_DB=fleet
# Separate database + user for Airflow's metadata.
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me_airflow
AIRFLOW_DB_NAME=airflow

# ---------- Telemetry producer (streaming source) ----------
NUM_VEHICLES=30
NUM_DRIVERS=25
# Each vehicle sends one event every 1-3 real seconds.
EMIT_INTERVAL_MIN_S=1
EMIT_INTERVAL_MAX_S=3
# Share of extra corrupted records (null vehicle_id, bad lat/lon, negative fare).
BAD_RECORD_RATE=0.02
# Share of events sent twice (same event_id) to test de-duplication.
DUPLICATE_RATE=0.01
# Vehicles with long idle periods (trigger idle alerts).
LAZY_VEHICLES=V007,V013,V021
# Vehicles with high fuel/maintenance costs (become unprofitable).
HIGH_COST_VEHICLES=V004,V011,V019,V027
KAFKA_CONNECT_MAX_RETRIES=10
PRODUCER_METRICS_PORT=8001

# ---------- Expense producer (daily batch source) ----------
LANDING_DIR=data/landing
EXPENSE_POLL_SECONDS=5
EXPENSE_METRICS_PORT=8002

# ---------- Speed layer (Spark Structured Streaming) ----------
# Read the topic from the beginning on first start (later starts use the checkpoint).
KAFKA_STARTING_OFFSETS=earliest
# One micro-batch every N real seconds.
SPARK_TRIGGER_SECONDS=10
# How long to wait for late events before a window is final.
STREAM_WATERMARK=2 minutes
# Tumbling window size in real seconds (60 s = 2.4 simulated hours).
STREAM_WINDOW_SECONDS=60
LAKE_PATH=data/lake/raw/telemetry
CHECKPOINT_DIR=data/checkpoints
SPARK_UI_PORT=4540
STREAMING_METRICS_PORT=8003

# ---------- Batch layer (Airflow) ----------
AIRFLOW_WEB_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_admin
# Any long random string (signs web session cookies).
AIRFLOW_SECRET_KEY=change_me_to_a_long_random_string
REPORTS_DIR=reports
# Short-lived Airflow tasks push their metrics here (service added in Phase 6).
PUSHGATEWAY_URL=pushgateway:9091

# ---------- Serving layer (FastAPI) ----------
API_PORT=8000
# /health reports "degraded" if the newest streamed event is older than this.
FRESHNESS_MAX_SECONDS=120

# ---------- Observability ----------
PUSHGATEWAY_PORT=9091
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana

# ---------- Business rules ----------
# Raise an idle alert when a vehicle stays idle longer than this (simulated minutes).
IDLE_ALERT_SIM_MINUTES=90
# A vehicle is "unprofitable" if profit < 0 OR profit margin < this value (0.10 = 10%).
UNPROFITABLE_MARGIN_THRESHOLD=0.10
# "Trending unprofitable" = profit fell 2+ days in a row AND margin below this (or a loss).
TRENDING_MARGIN_THRESHOLD=0.30

# ---------- Logging ----------
LOG_LEVEL=INFO
